{
  "name": "browserctl",
  "version": "0.0.0",
  "private": true,
  "description": "Browsers for agents over MCP, with a live dashboard for their operator",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "browserctl": "./bin/browserctl.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node scripts/test.ts fast",
    "env": "node scripts/env.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2"
  }
}
