{
  "name": "browserctl",
  "version": "0.0.0",
  "private": true,
  "description": "Browsers for agents over MCP, with a live dashboard for their operator",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "browserctl": "./bin/browserctl.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p dashboard/tsconfig.json",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "test": "node scripts/test.ts fast",
    "env": "node scripts/env.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.106",
    "@e2e-dev/web": "0.15.4",
    "@fontsource/asimovian": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@novnc/novnc": "1.7.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@playwright/mcp": "0.0.84",
    "ai": "7.0.159",
    "e2e": "0.22.0",
    "playwright-core": "1.65.0-alpha-2026-10-30",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/poppins": "5.3.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
