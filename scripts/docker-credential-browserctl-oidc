#!/bin/sh
set -eu

# ORAS invokes this helper whenever the registry requests authentication.
[ "$#" -eq 1 ] && [ "$1" = get ] || exit 1
: "${ARTIFACT_REGISTRY:?ARTIFACT_REGISTRY must name the registry}"
[ "$(cat)" = "$ARTIFACT_REGISTRY" ] || exit 1
: "${ACTIONS_ID_TOKEN_REQUEST_TOKEN:?GitHub Actions job has no OIDC permission}"
: "${ACTIONS_ID_TOKEN_REQUEST_URL:?GitHub Actions job has no OIDC endpoint}"

response=$(printf 'Authorization: Bearer %s\n' "$ACTIONS_ID_TOKEN_REQUEST_TOKEN" |
	curl -fsS --max-time 15 --header @- --get --data-urlencode "audience=https://$ARTIFACT_REGISTRY" \
		"$ACTIONS_ID_TOKEN_REQUEST_URL")
printf '%s' "$response" | jq -ce --arg server "$ARTIFACT_REGISTRY" '
	.value | select(type == "string" and length > 0) |
	{ServerURL: $server, Username: "oidc", Secret: .}'
