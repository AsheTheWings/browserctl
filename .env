# Generated from config/inputs.json by `node scripts/env.ts`; never edit it, and no process or tool loads it.
# Each input with its development default; an input without one is required in that profile.

# The profile whose defaults apply.
# class: configuration; production default: "production"
BROWSERCTL_PROFILE=development

# Colon-separated target overlay files of NAME=value lines, applied in order above the schema defaults.
# class: configuration; production default: ""
BROWSERCTL_OVERLAY_FILES=

# An owner-only file of NAME=value lines that may set only protected inputs, applied above the overlays.
# class: configuration; production default: ""
BROWSERCTL_PROTECTED_FILE=

# The home directory the XDG defaults start from.
# class: configuration; production default: none, required
# HOME=

# Where the server finds chrome, Xvfb, x11vnc, and ffmpeg; its child processes get this PATH and nothing else of the server's environment.
# class: configuration; production default: "/usr/local/bin:/usr/bin:/bin"
PATH=/usr/local/bin:/usr/bin:/bin

# The XDG state directory; empty counts as unset.
# class: configuration; production default: "${HOME}/.local/state"
XDG_STATE_HOME=${HOME}/.local/state

# The XDG cache directory; empty counts as unset.
# class: configuration; production default: "${HOME}/.cache"
XDG_CACHE_HOME=${HOME}/.cache

# Profiles, tasks, tokens, and the audit log; only the server's user may read it. Holds the admin socket.
# class: configuration; production default: "${XDG_STATE_HOME}/browserctl"
BROWSERCTL_STATE_DIRECTORY=${XDG_STATE_HOME}/browserctl

# Session recordings, deleted after 7 days or beyond the cap.
# class: configuration; production default: "${BROWSERCTL_STATE_DIRECTORY}/recordings"
BROWSERCTL_RECORDINGS_DIRECTORY=${BROWSERCTL_STATE_DIRECTORY}/recordings

# The size the recordings directory may reach before the oldest recordings are deleted.
# class: configuration; production default: "42949672960"
BROWSERCTL_RECORDINGS_CAP_BYTES=42949672960

# Session working directories: profile copies and file areas, removed when sessions end.
# class: configuration; production default: "${XDG_CACHE_HOME}/browserctl"
BROWSERCTL_WORK_DIRECTORY=${XDG_CACHE_HOME}/browserctl

# The address of the HTTP listener for MCP, the dashboard, the CDP relay, and the model forwarder.
# class: configuration; production default: "127.0.0.1"
BROWSERCTL_LISTEN_ADDRESS=127.0.0.1

# The port of the HTTP listener.
# class: configuration; production default: none, required
BROWSERCTL_PORT=8790

# The origin clients and the dashboard use; dashboard links start with it and dashboard requests must carry it as Origin.
# class: configuration; production default: none, required
BROWSERCTL_PUBLIC_BASE_URL=http://127.0.0.1:8790

# Managed sessions (profile, ephemeral, sign-in, and check sessions) open at once; more wait up to 60 seconds.
# class: configuration; production default: "4"
BROWSERCTL_SESSION_LIMIT=4

# Seconds without activity after which a session closes.
# class: configuration; production default: "1800"
BROWSERCTL_SESSION_IDLE_SECONDS=1800

# The age at which any session closes.
# class: configuration; production default: "14400"
BROWSERCTL_SESSION_LIFETIME_SECONDS=14400

# Seconds after which a task run is killed and reported as timed out.
# class: configuration; production default: "600"
BROWSERCTL_TASK_TIMEOUT_SECONDS=600

# Seconds between scheduled runs of each service's check task.
# class: configuration; production default: "43200"
BROWSERCTL_SERVICE_CHECK_INTERVAL_SECONDS=43200

# The OpenAI-compatible API base, ending in /v1, that the forwarder sends task runs' POST /responses to; empty disables model calls.
# class: configuration; production default: none, required
BROWSERCTL_MODEL_BASE_URL=

# The model task runs' agent steps use.
# class: configuration; production default: none, required
BROWSERCTL_MODEL_NAME=

# An owner-only file holding the model API key the forwarder adds to each request.
# class: protected; production default: none, required
BROWSERCTL_MODEL_KEY_FILE=

# JSON list of external providers: {"name", "leaseUrl", "cdpHost", "tokenFile"}, each tokenFile an owner-only file.
# class: configuration; production default: "[]"
BROWSERCTL_PROVIDERS=[]

# The deployment.environment.name resource attribute of exported telemetry.
# class: configuration; production default: none, required
BROWSERCTL_DEPLOYMENT_ENVIRONMENT=development

# Where spans go.
# class: configuration; production default: "otlp"
OTEL_TRACES_EXPORTER=otlp

# Where metrics go.
# class: configuration; production default: "otlp"
OTEL_METRICS_EXPORTER=otlp

# Where log records go.
# class: configuration; production default: "otlp"
OTEL_LOGS_EXPORTER=otlp

# The OTLP/HTTP base URL; signals go to its /v1/traces, /v1/metrics, and /v1/logs.
# class: configuration; production default: none, required
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# An owner-only file holding the OTLP export headers in OTEL_EXPORTER_OTLP_HEADERS form, key=value pairs separated by commas.
# class: protected; production default: ""
BROWSERCTL_OTLP_HEADERS_FILE=
